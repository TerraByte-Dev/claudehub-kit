#!/bin/sh
# Git Bash / MSYS shim. Hands off to the PowerShell implementation.
DIR="$(cd "$(dirname "$0")" && pwd)"
# Absolute path only, never a bare name looked up on PATH or in the current directory.
[ -n "$SYSTEMROOT" ] || { echo "secrets-kit: SYSTEMROOT is not set, cannot locate Windows PowerShell." >&2; exit 127; }
PS="$SYSTEMROOT/System32/WindowsPowerShell/v1.0/powershell.exe"
[ -x "$PS" ] || { echo "secrets-kit: Windows PowerShell not found under SYSTEMROOT." >&2; exit 127; }
if command -v cygpath >/dev/null 2>&1; then DIR="$(cygpath -w "$DIR")"; fi
exec "$PS" -NoProfile -ExecutionPolicy Bypass -File "$DIR\..\lib\run-with-secrets-impl.ps1" "$@"
